<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="tvFocusStrokeColor" format="reference|color" />

    <!-- Theme bridge for the RecyclerView-based TV top bar and video cards. -->
    <style name="Theme.BBTTVV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="tvFocusStrokeColor">@color/video_card_stroke</item>
        <item name="colorOnSurface">#E2E2E2</item>
        <item name="android:textColorSecondary">#A1A1A1</item>
    </style>

    <color name="tv_text_on_media">#EDEDED</color>
    <color name="ic_launcher_background">#212121</color>
    <string name="app_name">BBTTVV</string>
    <string name="tcl_shortcut_service_label">TCL 遥控器快捷键</string>
    <string name="tcl_shortcut_service_description">只响应指定遥控器快捷键以打开 BBTTVV，不读取屏幕内容。</string>
    <string name="video_card_accessibility_description">%1$s。%2$s</string>
    <string name="video_card_accessibility_owner">UP主 %1$s</string>
    <string name="video_card_accessibility_play_count">播放 %1$s</string>
    <string name="video_card_accessibility_danmaku_count">弹幕 %1$s</string>

    <dimen name="video_card_margin">8dp</dimen>
    <dimen name="video_card_duration_text_size">14sp</dimen>
    <dimen name="video_card_stat_icon_size">18dp</dimen>
    <dimen name="video_card_stat_text_size">14sp</dimen>
    <dimen name="video_card_title_text_size">16sp</dimen>
    <dimen name="video_card_subtitle_text_size">12sp</dimen>
</resources>
